# ============================================================
# 环境变量模板（阿里云百炼 / DashScope，OpenAI 兼容接口）
# 用法：cp .env.example .env 然后填入真实值
# ⚠️ .env 含真实密钥，绝不提交 git（已在 .gitignore 排除）
# ============================================================

# --- 阿里云百炼（LLM 和 Embedding 共用一套 key）---
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- LLM 分层（分流小模型 + 回答强模型，模型名可在百炼平台确认）---
ROUTER_MODEL=qwen-flash        # 分流器用（分类任务，速度优先成本低）
AGENT_MODEL=qwen-max           # 客服/售后/决策 Agent 用（能力最强）

# --- Embedding ---
EMBEDDING_MODEL=text-embedding-v3   # 1024 维（与 schema.sql 的 vector(1024) 对应）

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_agent
